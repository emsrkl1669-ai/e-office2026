rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrapAdmin() {
      return isVerifiedUser() && request.auth.token.email == 'emsrkl1669@gmail.com';
    }

    function hasRole(allowedRoles) {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role in allowedRoles;
    }

    function isAdmin() {
      return isBootstrapAdmin() || hasRole(['Admin']);
    }

    function isManager() {
      return isAdmin() || hasRole(['Manager']);
    }

    function isSupervisor() {
      return isManager() || hasRole(['Supervisor']);
    }

    function isRegistrar() {
      return isAdmin() || isManager() || hasRole(['Registrar']);
    }

    function isOrgDoc(data) {
      return data.orgId == 'ruamkuson_samutprakan';
    }

    function isNonEmptyStr(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    function isOptStr(data, field, maxLen) {
      return !(field in data) || (data[field] is string && data[field].size() <= maxLen);
    }

    function isImmutableOrgMeta() {
      return incoming().id == existing().id
        && incoming().orgId == existing().orgId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
    }

    // --- Validation Blueprints ---
    function isValidRoleAssignment(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'staffId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'staffId', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isNonEmptyStr(data.email, 200)
        && data.role in ['Admin', 'Manager', 'Supervisor', 'Registrar', 'Staff']
        && isValidId(data.staffId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffDirectory(data) {
      return data.keys().hasAll(['id', 'orgId', 'employeeCode', 'fullName', 'department', 'position', 'startDate', 'role', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'employeeCode', 'fullName', 'department', 'position', 'startDate', 'role', 'status', 'authUid', 'signatureDataUrl', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && isNonEmptyStr(data.employeeCode, 32)
        && isNonEmptyStr(data.fullName, 150)
        && isNonEmptyStr(data.department, 120)
        && isNonEmptyStr(data.position, 150)
        && isNonEmptyStr(data.startDate, 20)
        && data.role in ['Admin', 'Manager', 'Supervisor', 'Registrar', 'Staff']
        && data.status in ['Active', 'Inactive']
        && isOptStr(data, 'authUid', 128)
        && isOptStr(data, 'signatureDataUrl', 200000)
        && isNonEmptyStr(data.createdBy, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidStaffPrivate(data) {
      return data.keys().hasAll(['staffId', 'email', 'phone', 'pinHash', 'updatedAt'])
        && data.keys().hasOnly(['staffId', 'authUid', 'email', 'phone', 'pinHash', 'updatedAt'])
        && isValidId(data.staffId)
        && isOptStr(data, 'authUid', 128)
        && isOptStr(data, 'email', 200)
        && isOptStr(data, 'phone', 40)
        && isNonEmptyStr(data.pinHash, 128)
        && data.updatedAt is timestamp;
    }

    function isValidRegistryDoc(data) {
      return data.keys().hasAll(['id', 'orgId', 'docNumber', 'docDate', 'fromOrg', 'toOrg', 'subject', 'handlerName', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'docNumber', 'docDate', 'fromOrg', 'toOrg', 'subject', 'handlerName', 'attachmentName', 'attachmentData', 'notes', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && isNonEmptyStr(data.docNumber, 64)
        && isNonEmptyStr(data.docDate, 20)
        && isNonEmptyStr(data.fromOrg, 200)
        && isNonEmptyStr(data.toOrg, 200)
        && isNonEmptyStr(data.subject, 500)
        && isNonEmptyStr(data.handlerName, 150)
        && isOptStr(data, 'attachmentName', 255)
        && isOptStr(data, 'attachmentData', 500000)
        && isOptStr(data, 'notes', 1000)
        && isNonEmptyStr(data.createdBy, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLeaveRequest(data) {
      return data.keys().hasAll(['id', 'orgId', 'docNumber', 'requestCategory', 'leaveType', 'date', 'location', 'subject', 'applicantStaffId', 'applicantName', 'position', 'reason', 'startDate', 'endDate', 'totalDays', 'status', 'currentStep', 'approvalRoute', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'docNumber', 'requestCategory', 'leaveType', 'date', 'location', 'subject', 'applicantStaffId', 'applicantName', 'position', 'reason', 'startDate', 'endDate', 'totalDays', 'medicalCertName', 'medicalCertData', 'status', 'currentStep', 'approvalRoute', 'applicantSignature', 'supervisorSignature', 'managerSignature', 'rejectionReason', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && isNonEmptyStr(data.docNumber, 32)
        && data.requestCategory in ['leave', 'special']
        && isNonEmptyStr(data.leaveType, 80)
        && isNonEmptyStr(data.date, 20)
        && isNonEmptyStr(data.location, 200)
        && isNonEmptyStr(data.subject, 300)
        && isNonEmptyStr(data.applicantStaffId, 128)
        && isNonEmptyStr(data.applicantName, 150)
        && isNonEmptyStr(data.position, 150)
        && isNonEmptyStr(data.reason, 1000)
        && isNonEmptyStr(data.startDate, 20)
        && isNonEmptyStr(data.endDate, 20)
        && data.totalDays is number && data.totalDays >= 0 && data.totalDays <= 366
        && isOptStr(data, 'medicalCertName', 255)
        && isOptStr(data, 'medicalCertData', 500000)
        && data.status in ['pending_supervisor', 'pending_manager', 'approved', 'rejected']
        && data.currentStep is number && data.currentStep >= 1 && data.currentStep <= 5
        && data.approvalRoute is list && data.approvalRoute.size() > 0 && data.approvalRoute.size() <= 5 && data.approvalRoute[0] is string
        && isOptStr(data, 'rejectionReason', 500)
        && (!('applicantSignature' in data) || data.applicantSignature is map)
        && (!('supervisorSignature' in data) || data.supervisorSignature is map)
        && (!('managerSignature' in data) || data.managerSignature is map)
        && isNonEmptyStr(data.createdBy, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['id', 'orgId', 'code', 'name', 'category', 'unit', 'totalStock', 'availableStock', 'condition', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'code', 'name', 'category', 'unit', 'totalStock', 'availableStock', 'condition', 'location', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && isNonEmptyStr(data.code, 64)
        && isNonEmptyStr(data.name, 200)
        && isNonEmptyStr(data.category, 100)
        && isNonEmptyStr(data.unit, 40)
        && data.totalStock is number && data.totalStock >= 0 && data.totalStock <= 100000
        && data.availableStock is number && data.availableStock >= 0 && data.availableStock <= data.totalStock
        && isNonEmptyStr(data.condition, 100)
        && isOptStr(data, 'location', 150)
        && isNonEmptyStr(data.createdBy, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEquipmentLoan(data) {
      return data.keys().hasAll(['id', 'orgId', 'docNumber', 'borrowerName', 'purpose', 'borrowDate', 'dueDate', 'items', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'docNumber', 'borrowerName', 'borrowerPhone', 'purpose', 'borrowDate', 'dueDate', 'returnDate', 'items', 'status', 'borrowerSignature', 'staffSignature', 'returnNotes', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && isNonEmptyStr(data.docNumber, 64)
        && isNonEmptyStr(data.borrowerName, 150)
        && isOptStr(data, 'borrowerPhone', 40)
        && isNonEmptyStr(data.purpose, 500)
        && isNonEmptyStr(data.borrowDate, 20)
        && isNonEmptyStr(data.dueDate, 20)
        && isOptStr(data, 'returnDate', 20)
        && data.items is list && data.items.size() > 0 && data.items.size() <= 30 && data.items[0] is map
        && data.status in ['borrowed', 'returned']
        && (!('borrowerSignature' in data) || data.borrowerSignature is map)
        && (!('staffSignature' in data) || data.staffSignature is map)
        && isOptStr(data, 'returnNotes', 500)
        && isNonEmptyStr(data.createdBy, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVehicle(data) {
      return data.keys().hasAll(['id', 'orgId', 'callsign', 'plateNumber', 'vehicleType', 'station', 'driverName', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'callsign', 'plateNumber', 'vehicleType', 'station', 'driverName', 'crewNames', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && isNonEmptyStr(data.callsign, 64)
        && isNonEmptyStr(data.plateNumber, 40)
        && isNonEmptyStr(data.vehicleType, 64)
        && isNonEmptyStr(data.station, 150)
        && isNonEmptyStr(data.driverName, 150)
        && isOptStr(data, 'crewNames', 300)
        && data.status in ['ready', 'on_mission', 'maintenance']
        && isNonEmptyStr(data.createdBy, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidVehicleInspection(data) {
      return data.keys().hasAll(['id', 'orgId', 'vehicleId', 'callsign', 'plateNumber', 'inspectionDate', 'inspectorName', 'checklist', 'overallStatus', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'orgId', 'vehicleId', 'callsign', 'plateNumber', 'inspectionDate', 'inspectorName', 'checklist', 'overallStatus', 'notes', 'inspectorSignature', 'createdBy', 'createdAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && isValidId(data.vehicleId)
        && isNonEmptyStr(data.callsign, 64)
        && isNonEmptyStr(data.plateNumber, 40)
        && isNonEmptyStr(data.inspectionDate, 20)
        && isNonEmptyStr(data.inspectorName, 150)
        && data.checklist is list && data.checklist.size() == 12 && data.checklist[0] is map
        && data.overallStatus in ['pass', 'needs_repair']
        && isOptStr(data, 'notes', 1000)
        && (!('inspectorSignature' in data) || data.inspectorSignature is map)
        && isNonEmptyStr(data.createdBy, 128)
        && data.createdAt is timestamp;
    }

    function isValidRepairRequest(data) {
      return data.keys().hasAll(['id', 'orgId', 'docNumber', 'category', 'subCategory', 'assetName', 'issueDescription', 'estimatedCost', 'status', 'reporterName', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'docNumber', 'category', 'subCategory', 'assetName', 'locationOrPlate', 'issueDescription', 'estimatedCost', 'status', 'reporterName', 'repairNotes', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && isNonEmptyStr(data.docNumber, 64)
        && data.category in ['vehicle', 'medical', 'office', 'building']
        && isNonEmptyStr(data.subCategory, 100)
        && isNonEmptyStr(data.assetName, 200)
        && isOptStr(data, 'locationOrPlate', 150)
        && isNonEmptyStr(data.issueDescription, 1000)
        && data.estimatedCost is number && data.estimatedCost >= 0 && data.estimatedCost <= 10000000
        && data.status in ['pending', 'in_progress', 'completed', 'cancelled']
        && isNonEmptyStr(data.reporterName, 150)
        && isOptStr(data, 'repairNotes', 1000)
        && isNonEmptyStr(data.createdBy, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPavilionRequest(data) {
      return data.keys().hasAll(['id', 'orgId', 'docNumber', 'pavilionName', 'applicantName', 'relationship', 'phone', 'checkInDate', 'checkOutDate', 'deceasedName', 'ceremonyType', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'docNumber', 'pavilionName', 'applicantName', 'relationship', 'phone', 'checkInDate', 'checkInTime', 'checkOutDate', 'checkOutTime', 'cremationTemple', 'cremationDate', 'cremationTime', 'ceremonyType', 'lengJoeiColor', 'signageOptions', 'deceasedName', 'deceasedAge', 'deceasedNickname', 'bathingDate', 'schedules', 'cemeteryLocation', 'cemeteryDate', 'cemeteryTime', 'otherNotes', 'attachments', 'status', 'applicantSignature', 'approverSignature', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && isNonEmptyStr(data.docNumber, 64)
        && isNonEmptyStr(data.pavilionName, 100)
        && isNonEmptyStr(data.applicantName, 150)
        && isNonEmptyStr(data.relationship, 100)
        && isNonEmptyStr(data.phone, 40)
        && isNonEmptyStr(data.checkInDate, 20)
        && isOptStr(data, 'checkInTime', 20)
        && isNonEmptyStr(data.checkOutDate, 20)
        && isOptStr(data, 'checkOutTime', 20)
        && isOptStr(data, 'cremationTemple', 200)
        && isOptStr(data, 'cremationDate', 20)
        && isOptStr(data, 'cremationTime', 20)
        && data.ceremonyType in ['thai', 'chinese', 'mixed']
        && isOptStr(data, 'lengJoeiColor', 40)
        && (!('signageOptions' in data) || (data.signageOptions is list && data.signageOptions.size() <= 10))
        && isNonEmptyStr(data.deceasedName, 150)
        && isOptStr(data, 'deceasedAge', 20)
        && isOptStr(data, 'deceasedNickname', 60)
        && isOptStr(data, 'bathingDate', 30)
        && (!('schedules' in data) || (data.schedules is list && data.schedules.size() <= 15))
        && isOptStr(data, 'cemeteryLocation', 200)
        && isOptStr(data, 'cemeteryDate', 20)
        && isOptStr(data, 'cemeteryTime', 20)
        && isOptStr(data, 'otherNotes', 1000)
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 10))
        && data.status in ['pending', 'verified', 'approved', 'rejected']
        && (!('applicantSignature' in data) || data.applicantSignature is map)
        && (!('approverSignature' in data) || data.approverSignature is map)
        && isNonEmptyStr(data.createdBy, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFireReliefRequest(data) {
      return data.keys().hasAll(['id', 'orgId', 'docNumber', 'incidentDate', 'incidentLocation', 'victims', 'fullDamageCases', 'fullDamageRate', 'partialDamageCases', 'partialDamageRate', 'riceBagsPerCase', 'riceBagTotal', 'riceBagPrice', 'waterPacksPerCase', 'waterPackTotal', 'waterPackPrice', 'blanketsPerCase', 'blanketTotal', 'blanketPrice', 'totalValue', 'cashDisbursed', 'status', 'createdBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'docNumber', 'incidentDate', 'incidentTime', 'incidentLocation', 'certifiedDate', 'victims', 'fullDamageCases', 'fullDamageRate', 'partialDamageCases', 'partialDamageRate', 'deceasedCases', 'deceasedRate', 'riceBagsPerCase', 'riceBagTotal', 'riceBagPrice', 'waterPacksPerCase', 'waterPackTotal', 'waterPackPrice', 'blanketsPerCase', 'blanketTotal', 'blanketPrice', 'extraReliefNote', 'extraReliefValue', 'totalValue', 'cashDisbursed', 'attachments', 'notes', 'status', 'recorderName', 'approverSignature', 'createdBy', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && isNonEmptyStr(data.docNumber, 64)
        && isNonEmptyStr(data.incidentDate, 20)
        && isOptStr(data, 'incidentTime', 20)
        && isNonEmptyStr(data.incidentLocation, 300)
        && isOptStr(data, 'certifiedDate', 20)
        && data.victims is list && data.victims.size() <= 100
        && data.fullDamageCases is number && data.fullDamageCases >= 0 && data.fullDamageCases <= 10000
        && data.fullDamageRate is number && data.fullDamageRate >= 0 && data.fullDamageRate <= 1000000
        && data.partialDamageCases is number && data.partialDamageCases >= 0 && data.partialDamageCases <= 10000
        && data.partialDamageRate is number && data.partialDamageRate >= 0 && data.partialDamageRate <= 1000000
        && (!('deceasedCases' in data) || (data.deceasedCases is number && data.deceasedCases >= 0 && data.deceasedCases <= 1000))
        && (!('deceasedRate' in data) || (data.deceasedRate is number && data.deceasedRate >= 0 && data.deceasedRate <= 1000000))
        && data.riceBagsPerCase is number && data.riceBagsPerCase >= 0 && data.riceBagsPerCase <= 1000
        && data.riceBagTotal is number && data.riceBagTotal >= 0 && data.riceBagTotal <= 100000
        && data.riceBagPrice is number && data.riceBagPrice >= 0 && data.riceBagPrice <= 100000
        && data.waterPacksPerCase is number && data.waterPacksPerCase >= 0 && data.waterPacksPerCase <= 1000
        && data.waterPackTotal is number && data.waterPackTotal >= 0 && data.waterPackTotal <= 100000
        && data.waterPackPrice is number && data.waterPackPrice >= 0 && data.waterPackPrice <= 100000
        && data.blanketsPerCase is number && data.blanketsPerCase >= 0 && data.blanketsPerCase <= 1000
        && data.blanketTotal is number && data.blanketTotal >= 0 && data.blanketTotal <= 100000
        && data.blanketPrice is number && data.blanketPrice >= 0 && data.blanketPrice <= 100000
        && isOptStr(data, 'extraReliefNote', 300)
        && (!('extraReliefValue' in data) || (data.extraReliefValue is number && data.extraReliefValue >= 0 && data.extraReliefValue <= 10000000))
        && data.totalValue is number && data.totalValue >= 0 && data.totalValue <= 100000000
        && data.cashDisbursed is number && data.cashDisbursed >= 0 && data.cashDisbursed <= 100000000
        && (!('attachments' in data) || (data.attachments is list && data.attachments.size() <= 10))
        && isOptStr(data, 'notes', 1000)
        && data.status in ['pending', 'approved', 'rejected']
        && isOptStr(data, 'recorderName', 150)
        && (!('approverSignature' in data) || data.approverSignature is map)
        && isNonEmptyStr(data.createdBy, 128)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['id', 'orgId', 'title', 'message', 'category', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['id', 'orgId', 'title', 'message', 'category', 'readBy', 'createdBy', 'createdAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && isNonEmptyStr(data.title, 200)
        && isNonEmptyStr(data.message, 500)
        && data.category in ['incoming', 'outgoing', 'leave', 'approval', 'loan', 'pavilion', 'repair', 'fire_relief']
        && (!('readBy' in data) || (data.readBy is list && data.readBy.size() <= 100))
        && isNonEmptyStr(data.createdBy, 128)
        && data.createdAt is timestamp;
    }

    function isValidAppSettings(data) {
      return data.keys().hasAll(['id', 'orgId', 'leaveApprovalSteps', 'customVehicleTypes', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['id', 'orgId', 'leaveApprovalSteps', 'customVehicleTypes', 'updatedBy', 'updatedAt'])
        && isValidId(data.id)
        && data.orgId == 'ruamkuson_samutprakan'
        && data.leaveApprovalSteps is list && data.leaveApprovalSteps.size() > 0 && data.leaveApprovalSteps.size() <= 5 && data.leaveApprovalSteps[0] is string
        && data.customVehicleTypes is list && data.customVehicleTypes.size() <= 30
        && isNonEmptyStr(data.updatedBy, 128)
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---
    match /roles/{uid} {
      allow get: if isVerifiedUser() && (uid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.uid == request.auth.uid || isBootstrapAdmin());
      allow create: if isAdmin() && isValidId(uid) && isValidRoleAssignment(incoming()) && incoming().uid == uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(uid) && isValidRoleAssignment(incoming()) && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(uid);
    }

    match /staff_directory/{staffId} {
      allow get: if isVerifiedUser() && isOrgDoc(existing());
      allow list: if isVerifiedUser() && resource.data.orgId == 'ruamkuson_samutprakan';
      allow create: if isAdmin() && isValidId(staffId) && isValidStaffDirectory(incoming()) && incoming().id == staffId && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(staffId) && isValidStaffDirectory(incoming()) && isImmutableOrgMeta() && (
        isAdmin() ||
        (existing().authUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['signatureDataUrl', 'updatedAt']))
      );
      allow delete: if isAdmin() && isValidId(staffId);
    }

    match /staff_private/{staffId} {
      allow get: if isVerifiedUser() && (existing().authUid == request.auth.uid || isAdmin());
      allow list: if isVerifiedUser() && (resource.data.authUid == request.auth.uid || isBootstrapAdmin());
      allow create: if isAdmin() && isValidId(staffId) && isValidStaffPrivate(incoming()) && incoming().staffId == staffId && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(staffId) && isValidStaffPrivate(incoming()) && incoming().staffId == existing().staffId && incoming().updatedAt == request.time && (
        isAdmin() ||
        (existing().authUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['pinHash', 'updatedAt']))
      );
      allow delete: if isAdmin() && isValidId(staffId);
    }

    match /incoming_docs/{docId} {
      allow get: if isVerifiedUser() && isOrgDoc(existing());
      allow list: if isVerifiedUser() && resource.data.orgId == 'ruamkuson_samutprakan';
      allow create: if isVerifiedUser() && isValidId(docId) && isValidRegistryDoc(incoming()) && incoming().id == docId && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(docId) && isValidRegistryDoc(incoming()) && isImmutableOrgMeta() && (
        isAdmin() ||
        (isRegistrar() && incoming().diff(existing()).affectedKeys().hasOnly(['docDate', 'fromOrg', 'toOrg', 'subject', 'handlerName', 'attachmentName', 'attachmentData', 'notes', 'updatedAt']))
      );
      allow delete: if isRegistrar() && isValidId(docId);
    }

    match /outgoing_docs/{docId} {
      allow get: if isVerifiedUser() && isOrgDoc(existing());
      allow list: if isVerifiedUser() && resource.data.orgId == 'ruamkuson_samutprakan';
      allow create: if isVerifiedUser() && isValidId(docId) && isValidRegistryDoc(incoming()) && incoming().id == docId && incoming().createdBy == request.auth.uid && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(docId) && isValidRegistryDoc(incoming()) && isImmutableOrgMeta() && (
        isAdmin() ||
        (isRegistrar() && incoming().diff(existing()).affectedKeys().hasOnly(['docDate', 'fromOrg', 'toOrg', 'subject', 'handlerName', 'attachmentName', 'attachmentData', 'notes', 'updatedAt']))
      );
      allow delete: if isRegistrar() && isValidId(docId);
    }

    match /leave_requests/{reqId} {
      allow get: if isVerifiedUser() && isOrgDoc(existing());
      allow list: if isVerifiedUser() && (resource.data.createdBy == request.auth.uid || resource.data.orgId == 'ruamkuson_samutprakan');
